{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loopz",
  "version": "1.0.0",
  "identifier": "com.envelopedevelopment.loopz-linux",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Loopz — Drum Loops",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "120 gapless drum loops for practice and play-along"
  }
}
